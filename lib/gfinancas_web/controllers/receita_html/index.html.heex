<.flash_group flash={@flash} />

<!-- Cabeçalho -->
<.header class="mb-4">
  Lista de Receitas
  <:actions>
    <.link href={~p"/receitas/new"}>
      <.button class="btn btn-success">Nova receita</.button>
    </.link>
  </:actions>
</.header>

<!-- Formulário de Filtros -->
<form action={~p"/receitas"} method="get" class="mb-4">
  <div class="form-row">
    <div class="col">
      <label for="mes">Mês</label>
      <input type="month" name="mes" id="mes" class="form-control" value={@mes}>
    </div>
    <div class="col">
      <label for="inicio">Período Início</label>
      <input type="date" name="inicio" id="inicio" class="form-control" value={@inicio}>
    </div>
    <div class="col">
      <label for="fim">Período Fim</label>
      <input type="date" name="fim" id="fim" class="form-control" value={@fim}>
    </div>
    <div class="col">
      <label for="order">Ordenar por</label>
      <select name="order" id="order" class="form-control">
        <option value="">Selecione</option>
        <option value="maiores">Maiores receitas</option>
        <option value="menores">Menores receitas</option>
      </select>
    </div>
    <div class="col">
      <button type="submit" class="btn btn-primary mt-4">Filtrar</button>
    </div>
  </div>
</form>

<!-- Tabela de Receitas -->
<.table id="receitas" rows={@receitas} row_click={&JS.navigate(~p"/receitas/#{&1}")} class="table table-striped table-hover">
  <:col :let={receita} label="Nome"><%= receita.nome %></:col>
  <:col :let={receita} label="Valor">R$ <%= format_currency(receita.valor) %></:col>
  <:col :let={receita} label="Data"><%= format_date(receita.data) %></:col>
  <:action :let={receita}>
    <div class="sr-only">
      <.link navigate={~p"/receitas/#{receita}"}>Mostrar</.link>
    </div>
    <.link navigate={~p"/receitas/#{receita}/edit"} class="btn btn-primary btn-sm mr-2">Editar</.link>
  </:action>
  <:action :let={receita}>
    <.link href={~p"/receitas/#{receita}"} method="delete" data-confirm="Tem certeza?" class="btn btn-danger btn-sm">
      Deletar
    </.link>
  </:action>
</.table>
