<!-- Navbar --> 
<!-- Navbar -->
<nav class="navbar navbar-expand-lg fixed-top navbar-dark navbar-custom">
  <div class="container-fluid d-flex justify-content-center align-items-center">
    <a class="navbar-brand d-flex align-items-center" href="/">
      <img src="/images/logo01.png" width="40" height="40" class="d-inline-block align-top mr-2" alt="Logo" loading="lazy">
      <span>GFinanças</span>
    </a>
  </div>
</nav>

<.simple_form :let={f} for={@changeset} action={@action}>
  <.error :if={@changeset.action}>
    Oops, algo deu errado! Por favor, verifique os erros abaixo.
  </.error>
  <.input field={f[:nome]} type="text" label="Nome" />
  <.input field={f[:valor]} type="number" label="Valor" step="any" />
  <.input field={f[:data]} type="date" label="Data" />
  <:actions>
    <.button>Salvar Receita</.button>
  </:actions>
</.simple_form>
