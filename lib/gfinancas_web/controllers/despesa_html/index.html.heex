<.flash_group flash={@flash} />

<!-- Cabeçalho -->
<.header class="mb-4">
  Lista de Despesas
  <:actions>
    <.link href={~p"/despesas/new"}>
      <.button class="btn btn-success">Nova despesa</.button>
    </.link>
  </:actions>
</.header>

<!-- Formulário de Filtros -->
<form action={~p"/despesas"} method="get" class="mb-4">
  <div class="form-row">
    <div class="col">
      <label for="mes">Mês</label>
      <input type="month" name="mes" id="mes" class="form-control" value={@mes}>
    </div>
    <div class="col">
      <label for="inicio">Período Início</label>
      <input type="date" name="inicio" id="inicio" class="form-control" value={@inicio}>
    </div>
    <div class="col">
      <label for="fim">Período Fim</label>
      <input type="date" name="fim" id="fim" class="form-control" value={@fim}>
    </div>
    <div class="col">
      <label for="order">Ordenar por</label>
      <select name="order" id="order" class="form-control">
        <option value="">Selecione</option>
        <option value="maiores">Maiores despesas</option>
        <option value="menores">Menores despesas</option>
      </select>
    </div>
    <div class="col">
      <button type="submit" class="btn btn-primary mt-4">Filtrar</button>
    </div>
  </div>
</form>

<!-- Tabela de Despesas -->
<.table id="despesas" rows={@despesas} row_click={&JS.navigate(~p"/despesas/#{&1}")} class="table table-striped table-hover">
  <:col :let={despesa} label="Nome"><%= despesa.nome %></:col>
  <:col :let={despesa} label="Valor">R$ <%= format_currency(despesa.valor) %></:col>
  <:col :let={despesa} label="Data"><%= format_date(despesa.data) %></:col>
  <:action :let={despesa}>
    <div class="sr-only">
      <.link navigate={~p"/despesas/#{despesa}"}>Mostrar</.link>
    </div>
    <.link navigate={~p"/despesas/#{despesa}/edit"} class="btn btn-primary btn-sm mr-2">Editar</.link>
  </:action>
  <:action :let={despesa}>
    <.link href={~p"/despesas/#{despesa}"} method="delete" data-confirm="Tem certeza?" class="btn btn-danger btn-sm">
      Deletar
    </.link>
  </:action>
</.table>
