<!-- Navbar -->
<nav class="navbar navbar-expand-lg fixed-top navbar-dark navbar-custom">
  <div class="container-fluid d-flex justify-content-center align-items-center">
    <a class="navbar-brand d-flex align-items-center" href="/">
      <img src="/images/logo01.png" width="40" height="40" class="d-inline-block align-top mr-2" alt="Logo" loading="lazy">
      <span>GFinanças</span>
    </a>
  </div>
</nav>

<.header>
  Despesa <%= @despesa.id %>
  <:subtitle>Este é o registro para essa despesa no banco de dados.</:subtitle>
  <:actions>
    <.link href={~p"/despesas/#{@despesa}/edit"}>
      <.button>Editar despesa</.button>
    </.link>
  </:actions>
</.header>

<.list>
  <:item title="Nome"><%= @despesa.nome %></:item>
  <:item title="Valor"><%= @despesa.valor %></:item>
  <:item title="Data"><%= @despesa.data %></:item>
</.list>

<.back navigate={~p"/despesas"}>Voltar para despesas</.back>
